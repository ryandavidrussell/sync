# --- Logs and temporary outputs ---
*.log
logs/
tmp/
.tmp/
out/
outputs/

# --- Data / model artifacts ---
# Common heavyweight artifacts. Keep raw dataset zips checked in (they
# already live at repo root) but ignore unpacked working copies.
data/
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.parquet
*.feather
*.ckpt
*.pt
*.pth
*.onnx
*.tflite

# NOTE: We intentionally do NOT ignore *.json so that calibrated artifacts
# such as genesis_surrogate/calibrated_igen_weights_final.json remain tracked.
